    "Basis": {
      "description": "How a reported number was obtained, as the register says.",
      "enum": [
        "measured",
        "calculated",
        "estimated",
        "stated",
        "unknown"
      ],
      "title": "Basis",
      "type": "string"
    },
    "Claimed": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "n_facilities": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit",
        "basis",
        "source"
      ],
      "title": "Claimed",
      "type": "object"
    },
    "ClusterInfo": {
      "additionalProperties": false,
      "description": "Set on a finding whose subject is a cluster: the reported total sums several facilities,\nor a source just outside the 20 km footprint was left out (PLAN.md 1.7 fallback).",
