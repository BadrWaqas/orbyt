        "n_facilities"
      ],
      "title": "ClusterInfo",
      "type": "object"
    },
    "ClusterNeighbour": {
      "additionalProperties": false,
      "description": "The largest register source 20 to 60 km away. It is not in the footprint total.",
      "properties": {
        "distance_km": {
          "type": "number"
